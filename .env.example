# Local development defaults. Production requires API-key authentication and explicit repository
# roots; see docs/deployment.md.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-git-optimizer
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Development only. Production rejects disabled authentication.
AUTH_MODE=disabled
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
SHUTDOWN_GRACE_MS=10000

# Repository boundary ---------------------------------------------------------------------------
# Absolute directories that may contain analyzable repositories, separated by "," or ";".
# Production requires at least one; mount repositories read-only.
GIT_ALLOWED_ROOTS=
# Outside production only: treat the launch directory as the implicit root. The stdio entrypoint
# turns this on so `npm run mcp:stdio` works inside a coding workspace with no extra configuration.
GIT_LOCAL_PATHS_ENABLED=true
# Absolute path to a trusted Git executable. Discovered from PATH when unset.
GIT_EXECUTABLE=
# Required when a mounted repository is owned by a different user than the server process.
GIT_TRUST_REPOSITORY_OWNERSHIP=false

# Noise filtering -------------------------------------------------------------------------------
# Lockfiles, generated assets, and node_modules are filtered by default. Ambiguous directory names
# such as dist or build are not, because they hold real source in many projects.
GIT_EXTRA_IGNORED_BASENAMES=
GIT_EXTRA_IGNORED_DIRECTORIES=

# Work and output bounds ------------------------------------------------------------------------
GIT_TIMEOUT_MS=20000
GIT_CONCURRENCY=4
GIT_QUEUE_LIMIT=32
GIT_MAX_BUFFER_BYTES=8388608
GIT_MAX_PATCH_BYTES=2097152
GIT_MAX_ARGUMENT_BYTES=98304
GIT_MAX_FILES=200
GIT_MAX_IGNORED_FILES=200
GIT_MAX_PATH_LENGTH=1024
GIT_MAX_SUMMARY_LENGTH=60000
