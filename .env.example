# Local stdio defaults. The normal path needs no listener, API key, cloud, or provider.
NODE_ENV=development
LOG_LEVEL=info

# Repository boundary ---------------------------------------------------------------------------
# Absolute directories that may contain analyzable repositories, separated by "," or ";".
# The stdio entrypoint uses the launch directory when this is empty.
GIT_ALLOWED_ROOTS=
# Treat the launch directory as the implicit root.
GIT_LOCAL_PATHS_ENABLED=true
# Absolute path to a trusted Git executable. Discovered from PATH when unset.
GIT_EXECUTABLE=
# Only enable for a deliberately exposed repository owned by another user.
GIT_TRUST_REPOSITORY_OWNERSHIP=false

# Noise filtering -------------------------------------------------------------------------------
# Lockfiles, generated assets, and node_modules are filtered by default. Ambiguous directory names
# such as dist or build are not, because they hold real source in many projects.
GIT_EXTRA_IGNORED_BASENAMES=
GIT_EXTRA_IGNORED_DIRECTORIES=

# Work and output bounds ------------------------------------------------------------------------
GIT_TIMEOUT_MS=20000
GIT_CONCURRENCY=4
GIT_QUEUE_LIMIT=32
GIT_MAX_BUFFER_BYTES=8388608
GIT_MAX_PATCH_BYTES=2097152
GIT_MAX_ARGUMENT_BYTES=98304
GIT_MAX_FILES=200
GIT_MAX_IGNORED_FILES=200
GIT_MAX_PATH_LENGTH=1024
GIT_MAX_SUMMARY_LENGTH=60000
